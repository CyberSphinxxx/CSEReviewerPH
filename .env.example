# Philippine Exam Reviewer Platform (.env.example)
# Fill in real values in .env.local — never commit secrets

# Database (PostgreSQL)
# e.g., postgresql://postgres:password@localhost:5432/csereviewer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/csereviewer"

# Better Auth Configuration
BETTER_AUTH_SECRET="placeholder-secret-at-least-32-chars-long-123456"
BETTER_AUTH_URL="http://localhost:3000"

# PostHog Analytics (self-hostable / cloud)
NEXT_PUBLIC_POSTHOG_KEY="phc_placeholder_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=""

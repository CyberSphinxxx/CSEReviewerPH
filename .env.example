# Philippine Exam Reviewer Platform (.env.example)
# Fill in real values in .env.local for local dev, or configure in Vercel Project Settings for deployment.
# NEVER commit secrets.

# ==============================================================================
# Database (PostgreSQL / Neon / Supabase / Vercel Postgres)
# ==============================================================================
# Connection string: csereviewph.com supports either DATABASE_URL or POSTGRES_URL.
# If connecting to Neon or Supabase, SSL is automatically negotiated with rejectUnauthorized: false.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/csereviewer"
# POSTGRES_URL="" # Automatically provided if using Vercel Postgres / Neon marketplace integration

# Maximum connection pool size per serverless lambda (defaults to 5 if unset)
DB_POOL_MAX="5"

# ==============================================================================
# Application & Authentication
# ==============================================================================
# Canonical public URL (e.g., https://csereviewph.com).
# If omitted on Vercel, dynamically falls back to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth Configuration
BETTER_AUTH_SECRET="placeholder-secret-at-least-32-chars-long-123456"
BETTER_AUTH_URL="http://localhost:3000"

# ==============================================================================
# Analytics & Monitoring (Consent-gated per RA 10173)
# ==============================================================================
# PostHog Analytics (self-hostable / cloud)
NEXT_PUBLIC_POSTHOG_KEY="phc_placeholder_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=""

# ==============================================================================
# Monetization & Advertising (Google AdSense)
# ==============================================================================
# Google AdSense Publisher Client ID (e.g. ca-pub-1234567890123456).
# Used for verification meta tags, the AdSense script loader, and authorized digital seller records (/ads.txt).
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"
# ADSENSE_PUB_ID="pub-0000000000000000" # Optional override for /ads.txt if different

